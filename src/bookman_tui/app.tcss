/* Global styles for bookman-tui. */

/* ---- Browser (BROWSE) ---- */

#books {
    height: 1fr;
}

/* Bordered panels: static colours, so the two read as a pair; focus shows
   only in the table cursor. */
#books, #detail, #detail-screen {
    border: round $accent 65%;
    border-title-color: $accent 65%;
    background: $surface;
}

#book-table:focus {
    background-tint: $foreground 0%;
}

#book-table:focus > .datatable--header {
    background-tint: $foreground 0%;
}

/* Search (FIND-1): hidden until `/`, kept while a search is active; its
   match counts (FIND-7) sit at the right end of the row. */
#search-bar {
    display: none;
    height: 1;
    margin: 0 1 1 1;
}

#search {
    width: 1fr;
}

#search-counts {
    width: auto;
    padding: 0 0 0 2;
    color: $text-muted;
}

#book-table {
    height: 1fr;
}

/* ---- Detail pane (BROWSE-3, BROWSE-7) ---- */

#main {
    height: 1fr;
}

#detail {
    width: 44;
    height: 1fr;
    padding: 1 1 0 1;
}

BrowserScreen.narrow #detail, BrowserScreen.empty #detail {
    display: none;
}

#detail-screen {
    height: 1fr;
    padding: 1 1 0 1;
}

BookDetail Static {
    margin: 0;
}

#detail-cover {
    margin-bottom: 1;
}

#detail-trust, #detail-files-heading {
    margin-top: 1;
}

/* A fixed slot sized for a 2:3 cover (cells are about twice as tall as
   wide, so 28 columns of a 2:3 image are 21 rows). */
#detail-cover {
    width: 28;
    height: 21;
    align: center middle;
    background: $panel;
}

#cover-image {
    width: 100%;
    height: auto;
    max-height: 100%;
}

#cover-message {
    width: auto;
    color: $text-muted;
}

#detail-title {
    text-style: bold;
}

#detail-isbn, #detail-note {
    color: $text-muted;
}

#detail-files-heading {
    text-style: bold;
    color: $text-muted;
}

/* Empty library (BROWSE-6) or no matches (FIND-5), centred in the panel. */
#books-message {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---- Start problem (START-4/5) and Setup (SETUP) ---- */

#problem, #setup {
    width: 72;
    max-width: 100%;
    height: auto;
    margin: 2 0 0 0;
    padding: 1 2;
    border: round $primary;
}

StartProblemScreen, SetupScreen {
    align: center top;
}

#problem-heading, #setup-heading {
    text-style: bold;
    margin-bottom: 1;
}

#problem-heading {
    color: $error;
}

#problem-path {
    text-style: bold;
}

#problem-where, #setup-intro {
    color: $text-muted;
}

#setup-path {
    margin-top: 1;
}

#setup-hint {
    padding: 0 1;
    color: $text-muted;
}

#setup-hint.error {
    color: $error;
}

#setup-hint.confirm {
    color: $warning;
    text-style: bold;
}

#problem-reason {
    margin-top: 1;
}

#problem-buttons {
    height: auto;
    margin-top: 1;
}

#problem-buttons Button {
    width: auto;
    margin-right: 2;
}

/* ---- Import (IMPORT, ADR-10) ---- */

ImportScreen {
    align: center top;
}

#import {
    width: 100;
    max-width: 100%;
    height: 1fr;
    margin: 1 0 0 0;
    padding: 1 2;
    border: round $primary;
}

#stage-path, #stage-preview, #stage-running, #stage-summary {
    height: 1fr;
}

.import-heading {
    text-style: bold;
    margin-bottom: 1;
}

.import-intro {
    color: $text-muted;
    margin-bottom: 1;
}

#import-hint, #preview-hint, #run-current, #run-counts, #run-hint {
    padding: 0 1;
    color: $text-muted;
}

#import-hint.error {
    color: $error;
}

#import-recursive {
    margin: 1 0;
}

#preview-filter {
    margin-bottom: 1;
}

#preview-list, #run-log {
    height: 1fr;
}

#run-progress {
    margin-bottom: 1;
}

#run-log {
    margin-top: 1;
}

#summary-scroll {
    height: 1fr;
}

#summary-buttons {
    height: auto;
    margin-top: 1;
}

/* ---- Edit dialog (EDIT-1, ADR-11) ---- */

/* Darker than ModalScreen's default, so the details behind don't compete. */
EditDialog {
    align: center middle;
    background: $background 85%;
}

#edit-dialog {
    width: 72;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#edit-heading {
    text-style: bold;
    margin-bottom: 1;
}

#edit-trust {
    margin: 1 0;
}

#edit-dialog Label {
    color: $text-muted;
    margin-top: 1;
}

#edit-dialog Input {
    background: $boost;
}

#edit-record-author {
    margin-top: 1;
}

#edit-error {
    color: $error;
    margin-top: 1;
}

#edit-lookup {
    margin-top: 1;
}

#edit-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#edit-buttons Button {
    margin-left: 2;
}

/* LOOKUP-1: shown only while the selected book is looked up. */
#detail-busy {
    display: none;
    color: $text-muted;
    text-style: italic;
}
